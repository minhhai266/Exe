# Copy to .env.local; this is read on the server, never in the browser bundle.
# Use a Gemini API key, not the Google Sign-In OAuth Client ID.
GEMINI_API_KEY=AQ.Ab8RN6ITVlUTZI24cIhOR1YyT20l6yd6XhBPlYR_4EdBqdGwqQ
# Set the generateContent model ID available to your Google AI project.
GEMINI_MODEL=gemini-3.8-flash
# Google Sign-In: Web application OAuth Client ID (public, not a Gemini API key).
# Add your app origins in Google Cloud, e.g. http://localhost:5173.
# No Client Secret is needed for this Google Identity Services flow.
GOOGLE_CLIENT_ID=920234632283-3lo76uuoqtv4lgn9dac1159229rdfj04.apps.googleusercontent.com
# Reaction Studio: combined AI analysis/question attempts per account over 24 hours (1-100).
AI_STUDIO_DAILY_LIMIT=30
# SQLite path, relative to the project. Never use a VITE_ prefix for server secrets.
ADMIN_DB_PATH=.data/virtual-lab.sqlite
# Optional: required to initialize the first administrator from a remote machine.
# With no token, initialization is restricted to loopback connections.
ADMIN_SETUP_TOKEN=
# Set to 1 when serving through an HTTPS reverse proxy. Keep 0 for local HTTP.
ADMIN_SECURE_COOKIES=0
